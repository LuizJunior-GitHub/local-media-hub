# ==============================================================================
# Local Media Hub (Media Forge Server) - Configuration Environment
# ==============================================================================

# Application & API Gateway
APP_NAME="Local Media Hub"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["*"]

# ComfyUI Headless Engine Connection
COMFYUI_HOST="127.0.0.1"
COMFYUI_PORT=8188
COMFYUI_SSL=false
COMFYUI_CLIENT_ID="local-media-hub-worker"
COMFYUI_TIMEOUT_SECONDS=360

# Hardware & GPU Resource Management
# AMD Radeon RX 7800 XT (16 GB GDDR6)
GPU_DEVICE_NAME="AMD Radeon RX 7800 XT"
GPU_VRAM_GB=16
GPU_BACKEND="directml" # options: "directml", "rocm", "cuda", "cpu"
MAX_CONCURRENT_GPU_JOBS=1 # Strict GPU lock to protect 16GB VRAM from OOM

# Default Models & Weights
DEFAULT_SDXL_MODEL="juggernautXL_v9Rundiffusion.safetensors"
DEFAULT_FLUX_MODEL="flux1-schnell-Q4_K_S.gguf"
DEFAULT_CLIP_L="clip_l.safetensors"
DEFAULT_T5_XXL="t5xxl_fp8_e4m3fn.safetensors"
DEFAULT_FLUX_VAE="ae.safetensors"
DEFAULT_IPADAPTER_FACE_MODEL="ip-adapter-faceid-plusv2_sdxl.bin"
DEFAULT_CONTROLNET_DEPTH_MODEL="controlnet-depth-sdxl-1.0.safetensors"

# Storage Directories (Relative to project root or Absolute paths)
STORAGE_BASE_DIR="storage"
STORAGE_OUTPUTS_DIR="storage/outputs"
STORAGE_CHARACTERS_DIR="storage/references/characters"
STORAGE_LOCATIONS_DIR="storage/references/locations"

# Model Context Protocol (MCP) Server Configuration
MCP_SERVER_NAME="local-media-hub"
MCP_TRANSPORT="stdio" # "stdio" for AI agents/Claude/Antigravity, "sse" for remote HTTP/SSE
MCP_SSE_HOST="0.0.0.0"
MCP_SSE_PORT=8001
